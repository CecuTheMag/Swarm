# Public HTTPS for Swarm on a host whose ports 80 and 443 already belong to another
# Caddy (docs/demo-day.md, Plan A). Paste this block into that Caddyfile and restart
# or reload it: Caddy gets and renews the Let's Encrypt certificate by itself, as long
# as the name points to the host and port 80 reaches it. Replace the name with yours,
# and the upstream with the address at which that Caddy reaches Swarm's proxy
# (`SWARM_PORT`, 7780 by default, on the Docker host).
swarmrelay.duckdns.org {
	reverse_proxy 192.168.88.220:7780 {
		# Results and dashboard events stream through without buffering.
		flush_interval -1
	}
}
