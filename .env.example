# Copy to .env for local development.
DATABASE_URL=postgres://swarm:swarm@localhost:7732/swarm
REDIS_URL=redis://localhost:7779
COORDINATOR_ADDR=0.0.0.0:7700
RUST_LOG=info,coordinator=debug
# Results that must agree per unit (spec 0004). 1 lets a single device finish jobs in
# development; leave it unset in production (2).
SWARM_REDUNDANCY=1
# A platform admin created on start, for development and tests (spec 0010). Production
# uses `coordinator admin-create EMAIL` on the server instead.
# SWARM_BOOTSTRAP_ADMIN=you@example.com:a-long-development-password
# On this machine only: anyone may start jobs on the public network without its
# password, as `just job` does (spec 0016). Never set it on a server: there the public
# network takes jobs only with SWARM_SUBMIT_TOKEN.
SWARM_OPEN_PUBLIC=1
